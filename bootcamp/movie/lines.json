  "lines": [
    {
      "id": "L01",
      "voice": "n",
      "panel": "s01",
      "say": "借りた力が去ったあと、人は、何をもって立つのだろう。",
      "text": "",
      "dur": 3.842
    },
    {
      "id": "L02",
      "voice": "f",
      "panel": "s02",
      "say": "社長が使ってくれたら、うちも変われるのに。",
      "text": "",
      "dur": 3.232
    },
    {
      "id": "L03",
      "voice": "n",
      "panel": "s03",
      "say": "使えるもんなら、使うとる。あいつがおらん画面に、何を頼めばええんや。",
      "text": "",
      "dur": 6.073
    },
    {
      "id": "L04",
      "voice": "n",
      "panel": "s04",
      "say": "半年後。田村社長は、五時間の部屋に入った。",
      "text": "経営者だけの、5時間",
      "dur": 3.819
    },
    {
      "id": "L05",
      "voice": "f",
      "panel": "s05",
      "say": "ルールは一つ。五時間、他の仕事は捨ててください。",
      "text": "10:00 – 15:00",
      "dur": 3.6
    },
    {
      "id": "L06",
      "voice": "f",
      "panel": "s06",
      "say": "部屋を出るときには、三つできています。",
      "text": "",
      "dur": 2.496
    },
    {
      "id": "L07",
      "voice": "n",
      "panel": "card3",
      "say": "AIが自分のパソコンで動く。自社の数字につながる。人とAIと専門家の、線が引ける。",
      "text": "",
      "dur": 8.375
    },
    {
      "id": "L08",
      "voice": "n",
      "panel": "s07",
      "say": "「この見積、三通り出せ」。……二分か。去年は、半日や。",
      "text": "見積3案　半日 → 2分",
      "dur": 5.228
    },
    {
      "id": "L09",
      "voice": "n",
      "panel": "s08",
      "say": "あいつの言うとったこと、全部、意味があったんや。",
      "text": "",
      "dur": 4.025
    },
    {
      "id": "L10",
      "voice": "n",
      "panel": "s10",
      "say": "決めるんは、ワシらや。",
      "text": "決めるのは、人",
      "dur": 2.234
    },
    {
      "id": "L11",
      "voice": "n",
      "panel": "s12",
      "say": "五時間で、AI中級者以上に。経営者のための、AIブートキャンプ。",
      "text": "",
      "dur": 6.274
    }
  ]
}