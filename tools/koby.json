  "lines": [
    {
      "cue": 0.8,
      "text": "「補助金の対象になります」"
    },
    {
      "cue": 3.3,
      "text": "「自己負担は、四分の一で済みます」"
    },
    {
      "cue": 6.4,
      "text": "検討が、始まる。"
    },
    {
      "cue": 8.4,
      "text": "そして、月が変わる。"
    },
    {
      "cue": 12.2,
      "text": "「もうやめましょうよ！」",
      "cls": "big"
    },
    {
      "cue": 14.3,
      "text": "「消えなくてもいい時間が、消えています」",
      "cls": "big"
    },
    {
      "cue": 16.4,
      "text": "「時間が……もったいない」",
      "cls": "big"
    },
    {
      "cue": 26.0,
      "text": "「……いい社員さんですね」"
    },
    {
      "cue": 29.0,
      "text": "「十時間以上でないと、対象になりません」"
    },
    {
      "cue": 32.2,
      "text": "「計画届は、一か月半前」"
    },
    {
      "cue": 34.4,
      "text": "「職種ごとに、組み直します」"
    },
    {
      "cue": 36.6,
      "text": "「そして——実務は、訓練に使えません」"
    },
    {
      "cue": 39.2,
      "text": "「自社の数字ではなく、演習で学ぶことになる」"
    },
    {
      "cue": 42.6,
      "text": "「やりたかった研修では、なくなります」"
    },
    {
      "cue": 47.8,
      "text": "「三時間で、終わります」"
    },
    {
      "cue": 50.2,
      "text": "あえて、助成金を使いません。",
