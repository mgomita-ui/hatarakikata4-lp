  "lines": [
    {
      "cue": 0.0,
      "text": "人が来ない。<b>続かない。</b>",
      "say": "人が来ない。続かない。",
      "cls": ""
    },
    {
      "cue": 1.67,
      "text": "ヒントは、<b>社員の暮らし</b>に。",
      "say": "ヒントは、社員の暮らしに。",
      "cls": ""
    },
    {
      "cue": 3.96,
      "text": "本屋で、選んだ。",
      "say": "本屋で、選んだ。",
      "cls": ""
    },
    {
      "cue": 6.96,
      "text": "いまは、<b>アマゾン</b>でも選べる。",
      "say": "いまは、アマゾンでも選べる。",
      "cls": "mid"
    },
    {
      "cue": 11.96,
      "text": "放送を、待った。",
      "say": "放送を、待った。",
      "cls": ""
    },
    {
      "cue": 14.96,
      "text": "いまは、<b>ユーチューブ</b>でも観られる。",
      "say": "いまは、ユーチューブでも観られる。",
      "cls": "mid"
    },
    {
      "cue": 19.96,
      "text": "集まるために、移動した。",
      "say": "集まるために、移動した。",
      "cls": ""
    },
    {
      "cue": 22.96,
      "text": "離れていても、<b>話せる。</b>",
      "say": "離れていても、話せる。",
      "cls": "mid"
    },
    {
      "cue": 27.96,
      "text": "決まった時間に、教室へ。",
      "say": "決まった時間に、教室へ。",
      "cls": ""
    },
    {
      "cue": 30.96,
      "text": "<b>自分のペース</b>でも、学べる。",
      "say": "自分のペースでも、学べる。",
      "cls": "mid"
    },
    {
      "cue": 35.96,
      "text": "選べるのは、時間と場所だけか。",
      "say": "選べるのは、時間と場所だけか。",
      "cls": "scrim"
    },
    {
      "cue": 38.33,
      "text": "タクシーが、<b>自動で走り始めた。</b>",
      "say": "タクシーが、自動で走り始めた。",
      "cls": "scrim"
    },
    {
      "cue": 40.6,
      "text": "ロボットが、<b>力仕事を担う。</b>",
      "say": "ロボットが、力仕事を担う。",
      "cls": "scrim"
    },
    {
      "cue": 42.41,
      "text": "AIエージェントが、<b>仕事を進める。</b>",
      "say": "AIエージェントが、仕事を進める。",
      "cls": "scrim"
    },
    {
      "cue": 44.99,
      "text": "ビジネスの常識が、変わる。",
      "say": "ビジネスの常識が、変わる。",
      "cls": "scrim"
    },
    {
      "cue": 47.55,
      "text": "AIを使うか、<b>ではない。</b>",
      "say": "AIを使うか、ではない。",
      "cls": "scrim"
    },
    {
      "cue": 49.91,
      "text": "自社のビジネスを、<b>どう成り立たせるか。</b>",
      "say": "自社のビジネスを、どう成り立たせるか。",
      "cls": "big scrim"
    },
    {
      "cue": 52.28,
      "text": "AIと人。<b>仕事の任せ方</b>を変える。",
      "say": "AIと人。仕事の任せ方を変える。",
      "cls": ""
    },
    {
      "cue": 55.27,
      "text": "あなたの会社に合う、<b>働く条件</b>へ。",
      "say": "あなたの会社に合う、働く条件へ。",
      "cls": ""
    },
    {
      "cue": 58.12,
      "text": "<b>社会保険料</b>を、適正に整える。",
      "say": "社会保険料を、適正に整える。",
      "cls": ""
    },
    {
      "cue": 60.9,
      "text": "固定費が軽くなれば、<b>次の一手</b>へ。",
      "say": "固定費が軽くなれば、次の一手へ。",
      "cls": "mid"
    },
    {
      "cue": 63.33,
      "text": "人にも、AIにも、<b>投資できる。</b>",
      "say": "人にも、AIにも、投資できる。",
      "cls": ""
    },
    {
      "cue": 66.12,
      "text": "3年前に、その答えを<b>形にした男</b>がいる。",
      "say": "3年前に、その答えを形にした男がいる。",
      "cls": ""
    },
    {
      "cue": 69.46,
      "text": "少数精鋭。営業から納品まで、AIを活用。",
      "say": "少数精鋭。営業から納品まで、AIを活用。",
      "cls": ""
    },
    {
      "cue": 73.63,
      "text": "人との役割を組み替え、<b>圧倒的な成果</b>を出した。",
      "say": "人との役割を組み替え、圧倒的な成果を出した。",
      "cls": "mid"
    },
    {
      "cue": 77.46,
      "text": "「AI時代の、<b>儲け方</b>か？」",
      "say": "AI時代の、儲け方か？",
      "cls": ""
    },
    {
      "cue": 79.69,
      "text": "「<b>欲しければ、</b><b>くれてやる。</b>」",
      "say": "欲しければ、くれてやる。",
      "cls": ""
    },
    {
      "cue": 81.08,
      "text": "「<b>探せ。</b>ノウハウは、すべてまとめた。」",
      "say": "探せ。ノウハウは、すべてまとめた。",
      "cls": "mid"
    },
    {
      "cue": 84.0,
      "text": "「<b>手に入れた者が、</b><b>世界をとる。</b>」",
      "say": "手に入れた者が、世界をとる。",
      "cls": "mid"
    },
    {
      "cue": 86.22,
      "text": "利益も、<b>人に選ばれる条件</b>も。",
      "say": "利益も、人に選ばれる条件も。",
      "cls": ""
    },
    {
      "cue": 88.72,
      "text": "あなたの会社なら、<b>どう組み合わせるか。</b>",
      "say": "あなたの会社なら、どう組み合わせるか。",
      "cls": ""
    },
    {
      "cue": 91.51,
      "text": "人とAI。それぞれが、<b>生きる組織へ。</b>",
      "say": "人とAI。それぞれが、生きる組織へ。",
      "cls": "big"
    },
    {
      "cue": 94.71,
      "text": "世は、まさに――",
      "say": "世は、まさに――",
      "cls": "mid"
    },
    {
      "cue": 95.83,
      "text": "働き方4.0<span class=\"br\"><br></span>時代！",
      "say": "働き方、よんてんゼロ、時代！",
      "cls": "huge"
    },
    {
      "cue": 99.13,
      "text": "選べる働き方を、<b>会社の側から。</b>",
      "say": "選べる働き方を、会社の側から。",
      "cls": ""
    },
    {
      "cue": 101.56,
      "text": "AI時代の新しい最適解——<b>働き方4.0</b>。",
      "say": "エーアイ時代の、新しい最適解。働き方、よんてんゼロ。",
      "cls": ""
    }
  ]
